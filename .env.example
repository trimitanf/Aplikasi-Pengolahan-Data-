APP_NAME=BPOM-OTSK
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://otsk.pom.go.id
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Logging Configuration (Direkomendasikan 'daily' pada server production)
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Configuration (MySQL 8.0+ / MariaDB 10.5+)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bpom_otsk
DB_USERNAME=bpom_user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Session Management
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Queue & Background Jobs (Gunakan 'database' dengan Supervisor/NSSM, atau 'sync' untuk shared hosting)
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=300

# Cache Store
CACHE_STORE=database
# CACHE_PREFIX=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mailer Configuration
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@pom.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# Kredensial Awal Seed Akun (Opsional, jika kosong di production akan menggunakan password standar aman acak)
ADMIN_DEFAULT_PASSWORD=
EVALUATOR_DEFAULT_PASSWORD=
PENANDAAN_DEFAULT_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
